<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      全局按钮样式。
      关键：parent 用 Widget.AppCompat.Button 而不是 Material 的 Button，
      否则 MaterialComponents 主题会给按钮叠上 backgroundTint = colorPrimary，
      把白色背景染成主色，而文字又是主色 → 文字看不见。
      backgroundTint = @null 双保险。
    -->
    <style name="AppButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <style name="Theme.BleDebug" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSecondary">@color/colorPrimary</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="buttonStyle">@style/AppButton</item>
    </style>

    <style name="Theme.BleDebug.Dialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="buttonStyle">@style/AppButton</item>
    </style>

    <style name="DialogCard">
        <item name="android:background">@drawable/bg_dialog_card</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="CardText">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
